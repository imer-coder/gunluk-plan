<script>
const KEY='bambi-todo-v1';
const CATS={daily:'Günlük',work:'Çalışma',hobby:'Hobiler',personal:'Kişisel'};
const PRIS={low:'Düşük',mid:'Orta',high:'Yüksek'},PN={low:1,mid:2,high:3};
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const seed=()=>[
  {id:uid(),title:'Sabah çiçeklerine su ver',cat:'daily',pri:'mid',done:true},
  {id:uid(),title:'Proje sunumunu hazırla',cat:'work',pri:'high',done:false},
  {id:uid(),title:'Suluboya çalışmasına başla',cat:'hobby',pri:'low',done:false},
  {id:uid(),title:'Akşam yürüyüşü',cat:'personal',pri:'mid',done:false}];
let tasks;try{tasks=JSON.parse(localStorage.getItem(KEY))}catch(e){tasks=null}
if(!Array.isArray(tasks)){tasks=seed();save()}
let fStatus='all',fCat='all',fEn='all',editId=null,selDate='';
const $=id=>document.getElementById(id);
function save(){try{localStorage.setItem(KEY,JSON.stringify(tasks))}catch(e){}}
const esc=s=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const now=new Date(),h=now.getHours();
$('dateText').textContent=now.toLocaleDateString('tr-TR',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
const hello=h<6?'İyi geceler':h<12?'Günaydın':h<18?'İyi günler':'İyi akşamlar';
const pop=(x,y)=>{if(typeof confetti==='function')confetti({particleCount:60,spread:70,startVelocity:30,origin:{x,y},scalar:.85,colors:themeCols(),shapes:['circle']})};
const icoEdit='<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13.5 6.5l4 4"/></svg>';
const icoDel='<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>';
const icoChk='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';

function render(){
  const dayT=tasks.filter(t=>t.date===selDate),total=dayT.length,done=dayT.filter(t=>t.done).length,p=total?Math.round(done/total*100):0,left=total-done,tT=tasks.filter(t=>t.date===todayStr),tL=tT.filter(t=>!t.done).length;
  $('fill').style.width=p+'%';$('runner').style.left=p+'%';$('pct').textContent=p+'%';
  $('countText').textContent=`${done} / ${total} tamamlandı`;
  $('greet').textContent=`${hello}. `+(tT.length===0?'Listen boş, ilk görevini ekleyebilirsin.':tL===0?'Bugünün tüm görevleri tamamlandı.':`Bugün seni bekleyen ${tL} görev var.`);
  const list=dayT.filter(t=>(fStatus==='all'||(fStatus==='done')===t.done)&&(fCat==='all'||t.cat===fCat)&&(fEn==='all'||(t.energy||'high')===fEn));
  $('list').innerHTML=list.map(t=>`
    <li class="task c-${t.cat} ${t.done?'done':''} ${t.pri==='high'?'hi':''} p-3 flex items-center gap-3" data-id="${t.id}">
      <button class="chk" data-act="toggle" role="checkbox" aria-checked="${t.done}" aria-label="Tamamla">${icoChk}</button>
      <div class="min-w-0 flex-1">
        <p class="title font-medium break-words transition">${esc(t.title)}</p>
        <div class="flex items-center flex-wrap gap-2 mt-1">
          <span class="tag">${CATS[t.cat]}</span>
          ${t.pomos?`<span class="text-xs opacity-80">${t.pomos} pomodoro</span>`:''}
          <span class="text-xs opacity-80">${t.energy==='low'?'Düşük enerji':'Yüksek enerji'}</span>
          ${t.moved?'<span class="text-xs opacity-80">Bugüne kopyalandı</span>':''}
          <span class="pd text-xs opacity-80 flex items-center" title="Öncelik: ${PRIS[t.pri]}"><span class="mr-1.5">${PRIS[t.pri]}</span>${[1,2,3].map(i=>`<i class="${i<=PN[t.pri]?'on':''}"></i>`).join('')}</span>
        </div>
      </div>
      <button class="ib edit" data-act="edit" aria-label="Düzenle">${icoEdit}</button>
      <button class="ib del" data-act="del" aria-label="Sil">${icoDel}</button>
    </li>`).join('');
  $('empty').classList.toggle('hidden',list.length>0);
  $('emptyMsg').textContent=total===0?'Henüz görev yok.':(left===0&&fStatus!=='done')?'Tüm görevler tamamlandı.':'Bu filtrede görev yok.';
  fillTaskSelect();moodUI();calUI();dayUI();
}
function add(){
  const v=$('newTitle').value.trim();if(!v){$('newTitle').focus();return}
  tasks.unshift({id:uid(),title:v,cat:$('newCat').value,pri:$('newPri').value,energy:$('newEn').value,done:false,date:selDate});
  $('newTitle').value='';save();render();
}
$('addBtn').onclick=add;
$('newTitle').addEventListener('keydown',e=>{if(e.key==='Enter')add()});
$('list').addEventListener('click',e=>{
  const b=e.target.closest('[data-act]');if(!b)return;
  const li=b.closest('li'),t=tasks.find(x=>x.id===li.dataset.id);if(!t)return;
  if(b.dataset.act==='toggle'){
    t.done=!t.done;save();if(t.done)sfx();
    if(t.done){const r=b.getBoundingClientRect();pop((r.left+r.width/2)/innerWidth,(r.top+r.height/2)/innerHeight)}
    render();
    if(t.done&&tasks.filter(x=>x.date===t.date).every(x=>x.done)&&typeof confetti==='function')confetti({particleCount:150,spread:120,origin:{y:.4},colors:themeCols()});
  }else if(b.dataset.act==='del'){
    li.style.transition='.25s';li.style.opacity=0;li.style.transform='translateX(16px)';
    setTimeout(()=>{tasks=tasks.filter(x=>x.id!==t.id);save();render()},230);
  }else{
    editId=t.id;$('eTitle').value=t.title;$('eCat').value=t.cat;$('ePri').value=t.pri;$('eEn').value=t.energy||'high';
    $('modal').classList.remove('hidden');$('eTitle').focus();
  }
});
const closeModal=()=>{$('modal').classList.add('hidden');editId=null};
$('eCancel').onclick=closeModal;
$('modal').addEventListener('click',e=>{if(e.target.id==='modal')closeModal()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
$('eSave').onclick=()=>{const t=tasks.find(x=>x.id===editId),v=$('eTitle').value.trim();
  if(t&&v){t.title=v;t.cat=$('eCat').value;t.pri=$('ePri').value;t.energy=$('eEn').value;save();render()}closeModal()};
$('statusTabs').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;fStatus=b.dataset.s;
  [...$('statusTabs').children].forEach(x=>x.classList.toggle('active',x===b));render()});
$('catTabs').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;fCat=b.dataset.c;
  [...$('catTabs').children].forEach(x=>x.classList.toggle('active',x===b));render()});

// ---- Pomodoro ----
const PK='bambi-pomo-v1',C=326.7,MN={focus:'Odak',short:'Kısa mola',long:'Uzun mola'};
const todayStr=now.toLocaleDateString('sv-SE');
let ps={focus:25,short:5,long:15,day:'',count:0};
try{Object.assign(ps,JSON.parse(localStorage.getItem(PK))||{})}catch(e){}
if(ps.day!==todayStr){ps.day=todayStr;ps.count=0}
const psave=()=>{try{localStorage.setItem(PK,JSON.stringify(ps))}catch(e){}};
let mode='focus',remain=ps.focus*60000,running=false,endAt=0,timer=null,pTaskId='';
const modeMs=()=>ps[mode]*60000;
const fmt=ms=>{const s=Math.ceil(ms/1000);return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')};
function pUI(){
  $('time').textContent=fmt(remain);$('modeLabel').textContent=MN[mode];
  $('ring').style.strokeDashoffset=C*(1-remain/modeMs());
  $('pStart').textContent=running?'Duraklat':remain<modeMs()?'Devam et':'Başlat';
  [...$('modeTabs').children].forEach(b=>b.classList.toggle('active',b.dataset.m===mode));
  $('cycle').innerHTML=[0,1,2,3].map(i=>`<i class="${i<ps.count%4?'on':''}"></i>`).join('');
  $('todayCount').textContent=`Bugün ${ps.count} odak oturumu`;
  document.title=running?`${fmt(remain)} · ${MN[mode]}`:'Günlük Plan';
}
function beep(){try{const a=new(window.AudioContext||window.webkitAudioContext)();[0,.25,.5].forEach((d,i)=>{const o=a.createOscillator(),g=a.createGain(),s=a.currentTime+d;o.frequency.value=i==2?988:784;o.connect(g);g.connect(a.destination);g.gain.setValueAtTime(.0001,s);g.gain.exponentialRampToValueAtTime(.25,s+.03);g.gain.exponentialRampToValueAtTime(.0001,s+.22);o.start(s);o.stop(s+.25)})}catch(e){}}
function setMode(m){running=false;clearInterval(timer);mode=m;remain=modeMs();pUI()}
function tick(){remain=endAt-Date.now();if(remain<=0)finish();else pUI()}
function finish(){
  running=false;clearInterval(timer);beep();
  if(mode==='focus'){
    ps.count++;psave();
    const t=tasks.find(x=>x.id===pTaskId);if(t){t.pomos=(t.pomos||0)+1;save();render()}
    pop(.5,.45);
  }
  setMode(mode==='focus'?(ps.count%4===0?'long':'short'):'focus');
}
$('pStart').onclick=()=>{
  if(running){running=false;clearInterval(timer);remain=Math.max(0,endAt-Date.now());pUI();return}
  endAt=Date.now()+remain;running=true;timer=setInterval(tick,250);pUI();
};
$('pReset').onclick=()=>setMode(mode);
$('pSkip').onclick=()=>setMode(mode==='focus'?'short':'focus');
$('modeTabs').addEventListener('click',e=>{const b=e.target.closest('button');if(b)setMode(b.dataset.m)});
$('pTask').onchange=e=>{pTaskId=e.target.value};
function fillTaskSelect(){
  const open=tasks.filter(t=>!t.done&&t.date===todayStr);
  if(!open.some(t=>t.id===pTaskId))pTaskId='';
  $('pTask').innerHTML='<option value="">Görev seçilmedi</option>'+open.map(t=>`<option value="${t.id}">${esc(t.title)}</option>`).join('');
  $('pTask').value=pTaskId;
}
['focus','short','long'].forEach(k=>{
  const el=$('s'+k);el.value=ps[k];
  el.onchange=()=>{const v=Math.min(+el.max,Math.max(1,parseInt(el.value)||ps[k]));el.value=v;ps[k]=v;psave();if(!running&&mode===k){remain=modeMs();pUI()}};
});

// ---- Kişiselleştirme ----
const PREF='bambi-prefs-v1';
const THEMES=[
 {k:'classic',n:'Klasik',c:'Pembe & turkuaz',a:'#E0658C',b:'#2EC4B6'},
 {k:'coral',n:'Living Coral',c:'16-1546 TCX',a:'#FF6F61',b:'#3FB8AF'},
 {k:'greenery',n:'Greenery',c:'15-0343 TCX',a:'#88B04B',b:'#E58FA6'},
 {k:'quartz',n:'Rose Quartz & Serenity',c:'13-1520 · 15-3919 TCX',a:'#F7CAC9',b:'#92A8D1'},
 {k:'emerald',n:'Emerald',c:'17-5641 TCX',a:'#009473',b:'#E9B872'},
 {k:'tango',n:'Tangerine Tango',c:'17-1463 TCX',a:'#DD4124',b:'#3AA7A3'},
 {k:'honey',n:'Honeysuckle',c:'18-2120 TCX',a:'#D94F70',b:'#45B8AC'},
 {k:'turq',n:'Turquoise',c:'15-5519 TCX',a:'#45B8AC',b:'#F4978E'},
 {k:'mimosa',n:'Mimosa',c:'14-0848 TCX',a:'#EFC050',b:'#8E7CC3'},
 {k:'sand',n:'Sand Dollar',c:'13-1106 TCX',a:'#DECDBE',b:'#7E9BB4'},
 {k:'iris',n:'Blue Iris',c:'18-3943 TCX',a:'#5B5EA6',b:'#EE9BB0'}];
let S={theme:'classic',fx:'off',sfx:'drop',washi:'plaid',amb:'off',vol:.4,note:'',nc:'#FFD9E3',quotes:[],qi:0,qd:'',water:{day:'',n:0},mood:{day:'',m:''},stk:[],custom:''};
try{Object.assign(S,JSON.parse(localStorage.getItem(PREF))||{})}catch(e){}
if(S.amb==='rain')S.amb='off';
if(!THEMES.some(x=>x.k===S.theme))S.theme='classic';
const sv=()=>{try{localStorage.setItem(PREF,JSON.stringify(S))}catch(e){}};
let AC;const actx=()=>{AC=AC||new(window.AudioContext||window.webkitAudioContext)();if(AC.state==='suspended')AC.resume();return AC};
const noise=c=>{const b=c.createBuffer(1,c.sampleRate*2,c.sampleRate),d=b.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;const s=c.createBufferSource();s.buffer=b;s.loop=true;return s};

// renk temaları
let TA='#E0658C',TB='#2EC4B6';
const rgb=h=>[1,3,5].map(i=>parseInt(h.substr(i,2),16));
const hex=c=>'#'+c.map(v=>Math.round(v).toString(16).padStart(2,'0')).join('');
const lum=h=>{const c=rgb(h).map(v=>{v/=255;return v<=.03928?v/12.92:Math.pow((v+.055)/1.055,2.4)});return .2126*c[0]+.7152*c[1]+.0722*c[2]};
const onCol=h=>lum(h)>.3?'#3B2A22':'#fff';
const mixTo=(h,k,p)=>hex(rgb(h).map((v,i)=>v*(1-p)+k[i]*p));
const strong=h=>lum(h)>.42?mixTo(h,[59,42,34],.45):h;
const hexA=(h,a)=>`rgba(${rgb(h).join(',')},${a})`;
const themeCols=()=>[TA,mixTo(TA,[255,255,255],.5),TB,mixTo(TB,[255,255,255],.5),'#C9A24B'];
function applyTheme(){
  const th=THEMES.find(x=>x.k===S.theme)||THEMES[0],r=document.documentElement.style,A=strong(th.a),B=strong(th.b);TA=th.a;TB=th.b;
  r.setProperty('--a',th.a);r.setProperty('--b',th.b);r.setProperty('--ad',A);r.setProperty('--bd',B);r.setProperty('--ona',onCol(A));r.setProperty('--onb',onCol(B));
  const dk=(lum(th.a)+lum(th.b))/2<=.3;
  r.setProperty('--onh',dk?'#fff':'#3B2A22');r.setProperty('--hsh',dk?'rgba(59,42,34,.25)':'rgba(255,255,255,.28)');r.setProperty('--tsh',dk?'rgba(59,42,34,.5)':'rgba(255,255,255,.6)');
  document.querySelectorAll('#themeGrid button').forEach(b=>b.classList.toggle('active',b.dataset.t===S.theme));
  const n=$('note');if(n)n.style.background=`color-mix(in srgb,var(--${S.nc==='b'?'b':'a'}) 28%,white)`;
}
$('themeGrid').innerHTML=THEMES.map(x=>`<button class="swb" data-t="${x.k}"><span class="sws"><i style="background:${x.a}"></i><i style="background:${x.b}"></i></span><span class="text-left leading-tight"><b class="block text-sm font-semibold">${x.n}</b><small class="opacity-70">${x.c}</small></span></button>`).join('');

// tamamlama sesleri
function sfx(){
  const k=S.sfx;if(k==='off')return;const c=actx(),t=c.currentTime;
  const tone=(f1,f2,d,v,at=0)=>{const o=c.createOscillator(),g=c.createGain();o.frequency.setValueAtTime(f1,t+at);o.frequency.exponentialRampToValueAtTime(f2,t+at+d);g.gain.setValueAtTime(.0001,t+at);g.gain.exponentialRampToValueAtTime(v,t+at+.02);g.gain.exponentialRampToValueAtTime(.0001,t+at+d);o.connect(g);g.connect(c.destination);o.start(t+at);o.stop(t+at+d+.05)};
  if(k==='drop'){tone(1400,500,.18,.3);tone(2100,900,.1,.08,.02)}
  if(k==='harp')[523,659,784,1047,1319].forEach((f,i)=>tone(f,f,.7,.16,i*.07));
  if(k==='pop')tone(520,140,.1,.4);
  if(k==='paper'){const n=noise(c),f=c.createBiquadFilter(),g=c.createGain();f.type='highpass';f.frequency.value=2500;g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.25,t+.02);g.gain.exponentialRampToValueAtTime(.0001,t+.25);n.connect(f);f.connect(g);g.connect(c.destination);n.start(t);n.stop(t+.3)}
}

// ortam sesi (cihazda üretilir)
let amb=null;
function stopAmb(){if(!amb)return;amb.tm.forEach(clearInterval);amb.nd.forEach(n=>{try{n.stop&&n.stop()}catch(e){}try{n.disconnect()}catch(e){}});amb=null}
function ambSync(){
  stopAmb();if(S.amb==='off')return;const c=actx(),g=c.createGain();g.gain.value=S.vol;g.connect(c.destination);const nd=[g],tm=[];
  if(S.amb==='birds'){const n=noise(c),f=c.createBiquadFilter(),ng=c.createGain();f.type='lowpass';f.frequency.value=500;ng.gain.value=.2;n.connect(f);f.connect(ng);ng.connect(g);n.start();nd.push(n);
    tm.push(setInterval(()=>{if(Math.random()<.6){const o=c.createOscillator(),e=c.createGain(),t=c.currentTime,f0=2200+Math.random()*1800;o.frequency.setValueAtTime(f0,t);o.frequency.exponentialRampToValueAtTime(f0*1.4,t+.12);e.gain.setValueAtTime(.0001,t);e.gain.exponentialRampToValueAtTime(.12,t+.03);e.gain.exponentialRampToValueAtTime(.0001,t+.2);o.connect(e);e.connect(g);o.start(t);o.stop(t+.22)}},800))}
  if(S.amb==='lofi'){const ch=[[220,277,330,415],[196,247,294,392],[175,220,262,330],[196,247,294,370]],lp=c.createBiquadFilter();let i=0;lp.type='lowpass';lp.frequency.value=900;lp.connect(g);
    const play=()=>{const t=c.currentTime;ch[i++%4].forEach(fr=>{const o=c.createOscillator(),e=c.createGain();o.type='triangle';o.frequency.value=fr;e.gain.setValueAtTime(.0001,t);e.gain.exponentialRampToValueAtTime(.12,t+.1);e.gain.exponentialRampToValueAtTime(.0001,t+3.6);o.connect(e);e.connect(lp);o.start(t);o.stop(t+3.7)})};
    play();tm.push(setInterval(play,3800));const n=noise(c),nf=c.createBiquadFilter(),ng=c.createGain();nf.type='highpass';nf.frequency.value=3000;ng.gain.value=.03;n.connect(nf);nf.connect(ng);ng.connect(g);n.start();nd.push(n)}
  amb={nd,tm,g};
}
$('vol').value=S.vol;$('vol').oninput=e=>{S.vol=+e.target.value;if(amb)amb.g.gain.value=S.vol;sv()};

// ekran efektleri
const cv=$('fx'),cx=cv.getContext('2d'),RM=matchMedia('(prefers-reduced-motion:reduce)').matches;let P=[],raf=0;
const fit=()=>{cv.width=innerWidth;cv.height=innerHeight};addEventListener('resize',fit);fit();
function fxStart(){
  cancelAnimationFrame(raf);P=[];cx.clearRect(0,0,cv.width,cv.height);if(S.fx==='off'||RM)return;
  for(let i=0;i<30;i++)P.push({x:Math.random()*cv.width,y:Math.random()*cv.height,r:4+Math.random()*7,s:.3+Math.random()*.6,ph:Math.random()*6.3,rot:Math.random()*6.3});
  const loop=()=>{cx.clearRect(0,0,cv.width,cv.height);const k=S.fx;
    P.forEach(p=>{p.ph+=.012;
      if(k==='sakura'){p.y+=p.s;p.x+=Math.sin(p.ph)*.6;p.rot+=.01;if(p.y>cv.height+10){p.y=-10;p.x=Math.random()*cv.width}cx.save();cx.translate(p.x,p.y);cx.rotate(p.rot);cx.fillStyle=hexA(TA,.7);cx.beginPath();cx.ellipse(0,0,p.r,p.r*.55,0,0,6.3);cx.fill();cx.restore()}
      else if(k==='fire'){p.x+=Math.sin(p.ph)*.4;p.y+=Math.cos(p.ph*.8)*.3;p.x=(p.x+cv.width)%cv.width;p.y=(p.y+cv.height)%cv.height;const a=.35+.45*Math.sin(p.ph*3),g=cx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*2.2);g.addColorStop(0,hexA(TB,a));g.addColorStop(1,hexA(TB,0));cx.fillStyle=g;cx.beginPath();cx.arc(p.x,p.y,p.r*2.2,0,6.3);cx.fill()}
      else{p.y-=p.s*.7;p.x+=Math.sin(p.ph)*.4;if(p.y<-12){p.y=cv.height+12;p.x=Math.random()*cv.width}cx.save();cx.translate(p.x,p.y);cx.scale(p.r/12,p.r/12);cx.fillStyle=hexA(TA,.55);cx.beginPath();cx.moveTo(0,6);cx.bezierCurveTo(-14,-4,-6,-14,0,-5);cx.bezierCurveTo(6,-14,14,-4,0,6);cx.fill();cx.restore()}});
    raf=requestAnimationFrame(loop)};loop();
}

// sticker'lar
const STK={
  butterfly:'<svg viewBox="0 0 48 40"><path d="M24 20C16 4 3 6 5 18c1 8 12 10 19 2zM24 20C32 4 45 6 43 18c-1 8-12 10-19 2z" style="fill:var(--a)"/><path d="M24 20c-6 8-12 18-6 18 5 0 6-10 6-18zM24 20c6 8 12 18 6 18-5 0-6-10-6-18z" style="fill:var(--b)"/><rect x="23" y="12" width="2" height="22" rx="1" fill="#3B2A22"/></svg>',
  hoof:'<svg viewBox="0 0 48 48"><g fill="#C9A27E"><path d="M13 8c6 2 6 16 2 28-7-8-8-24-2-28z"/><path d="M33 12c6 2 6 16 2 28-7-8-8-24-2-28z"/></g></svg>',
  coffee:'<svg viewBox="0 0 48 48"><path d="M8 18h26v10a10 10 0 01-10 10h-6A10 10 0 018 28z" fill="#fff" stroke="#3B2A22" stroke-width="2"/><path d="M34 21h3a5 5 0 010 10h-4" fill="none" stroke="#3B2A22" stroke-width="2"/><path d="M14 12c-2-3 2-4 0-7M22 12c-2-3 2-4 0-7" style="stroke:var(--a)" stroke-width="2" fill="none" stroke-linecap="round"/></svg>',
  sparkle:'<svg viewBox="0 0 48 48"><path d="M22 3l5 16 16 5-16 5-5 16-5-16-16-5 16-5z" fill="#C9A24B"/><path d="M39 4l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" style="fill:var(--b)"/></svg>',
  lily:'<svg viewBox="-50 -50 100 100"><use href="#lily"/></svg>',
  heart:'<svg viewBox="0 0 48 44"><path d="M24 41C6 28 3 17 9 9c5-5 13-3 15 3 2-6 10-8 15-3 6 8 3 19-15 32z" style="fill:var(--a)"/></svg>',
  great:'<span class="txt" style="background:var(--teal);color:var(--onb)">Harika iş!</span>',
  done:'<span class="txt" style="background:var(--rose);color:var(--ona)">Tamamdı ✓</span>'};
$('stkGrid').innerHTML=Object.keys(STK).map(k=>`<div class="si" data-k="${k}">${STK[k]}</div>`).join('');
function mkStk(s){const d=document.createElement('div');d.className='stk'+(STK[s.k].startsWith('<span')?' t':'');d.dataset.id=s.id;
  d.style.cssText=`left:${s.x}px;top:${s.y}px;transform:rotate(${s.r}deg)`;d.innerHTML=STK[s.k]+'<button class="x" aria-label="Sil">×</button>';return d}
S.stk=S.stk.filter(s=>STK[s.k]);S.stk.forEach(s=>$('stkLayer').appendChild(mkStk(s)));
$('stkLayer').addEventListener('pointerdown',e=>{
  const el=e.target.closest('.stk');if(!el)return;const s=S.stk.find(x=>x.id===el.dataset.id);if(!s)return;
  if(e.target.classList.contains('x')){S.stk=S.stk.filter(x=>x!==s);el.remove();sv();return}
  document.querySelectorAll('.stk.sel').forEach(n=>n.classList.remove('sel'));el.classList.add('sel');
  const w=$('wrap').getBoundingClientRect(),dx=e.clientX-w.left-s.x,dy=e.clientY-w.top-s.y;el.setPointerCapture(e.pointerId);
  const mv=ev=>{const r=$('wrap').getBoundingClientRect();s.x=ev.clientX-r.left-dx;s.y=ev.clientY-r.top-dy;el.style.left=s.x+'px';el.style.top=s.y+'px'};
  const up=()=>{el.removeEventListener('pointermove',mv);el.removeEventListener('pointerup',up);sv()};
  el.addEventListener('pointermove',mv);el.addEventListener('pointerup',up);
});
$('stkGrid').addEventListener('pointerdown',e=>{
  const si=e.target.closest('.si');if(!si)return;e.preventDefault();
  const g=si.cloneNode(true);g.style.cssText='position:fixed;left:0;top:0;z-index:60;pointer-events:none;opacity:.9';document.body.appendChild(g);
  let moved=false;const sx=e.clientX,sy=e.clientY;
  const pos=ev=>{g.style.transform=`translate(${ev.clientX-27}px,${ev.clientY-27}px)`;if(Math.hypot(ev.clientX-sx,ev.clientY-sy)>6){moved=true;$('panel').classList.add('fade')}};pos(e);
  const up=ev=>{removeEventListener('pointermove',pos);removeEventListener('pointerup',up);g.remove();$('panel').classList.remove('fade');
    const w=$('wrap').getBoundingClientRect();let x,y;
    if(moved){x=ev.clientX-w.left-28;y=ev.clientY-w.top-28}else{x=w.width*(.15+Math.random()*.65);y=Math.max(20,innerHeight/2-w.top+Math.random()*120-60)}
    const s={id:uid(),k:si.dataset.k,x,y,r:Math.round(Math.random()*24-12)};S.stk.push(s);$('stkLayer').appendChild(mkStk(s));sv()};
  addEventListener('pointermove',pos);addEventListener('pointerup',up);
});

// paneller
let openP='';
$('dock').addEventListener('click',e=>{const b=e.target.closest('[data-p]');if(!b)return;openP=openP===b.dataset.p?'':b.dataset.p;
  $('panel').classList.toggle('hidden',!openP);document.querySelectorAll('[data-pn]').forEach(d=>d.classList.toggle('hidden',d.dataset.pn!==openP))});
function syncChips(){document.querySelectorAll('#panel [data-fx],#panel [data-sfx],#panel [data-wa],#panel [data-amb]').forEach(b=>{const d=b.dataset;
  b.classList.toggle('active',d.fx===S.fx||d.sfx===S.sfx||d.wa===S.washi||d.amb===S.amb)});$('list').dataset.washi=S.washi}
$('panel').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const d=b.dataset;
  if(d.t){S.theme=d.t;applyTheme()}
  if(d.fx){S.fx=d.fx;fxStart()}if(d.sfx){S.sfx=d.sfx;sfx()}if(d.wa)S.washi=d.wa;if(d.amb){S.amb=d.amb;ambSync()}
  if(d.clr){S.stk=[];$('stkLayer').innerHTML=''}sv();syncChips()});

// ruh hali ve enerji
const MOODS={energetic:['Enerjik','Bugün tempo yüksek, güzel gidiyor.'],tired:['Biraz yorgun','Yavaş git, küçük adımlar da sayılır.'],focus:['Odaklanmış','Odak zamanı, bir görevi seç ve başla.'],calm:['Sakin','Sakin bir gün, ritmini koru.']};
$('moods').innerHTML=Object.entries(MOODS).map(([k,v])=>`<button class="chip" data-m="${k}">${v[0]}</button>`).join('');
$('moods').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;S.mood={day:todayStr,m:b.dataset.m};sv();
  if(b.dataset.m==='tired')setEn('low');else render()});
function moodUI(){const m=S.mood.day===todayStr&&MOODS[S.mood.m];
  [...$('moods').children].forEach(b=>b.classList.toggle('active',!!m&&b.dataset.m===S.mood.m));
  if(m){const left=tasks.filter(t=>!t.done&&t.date===todayStr).length;$('greet').textContent=`${hello}. ${m[1]} `+(left?`${left} görev seni bekliyor.`:'Tüm görevler tamam.')}}
function setEn(v){fEn=v;[...$('enTabs').children].forEach(x=>x.classList.toggle('active',x.dataset.e===v));render()}
$('enTabs').addEventListener('click',e=>{const b=e.target.closest('button');if(b)setEn(b.dataset.e)});

// not, söz, su
$('noteTxt').value=S.note;
$('noteTxt').oninput=e=>{S.note=e.target.value;sv()};
$('note').addEventListener('click',e=>{const b=e.target.closest('[data-nc]');if(!b)return;S.nc=b.dataset.nc;applyTheme();sv()});
const QS=['Küçük adımlar da seni ilerletir.','Bugün yapabildiğin kadarı yeterli.','Odaklan, nefes al, devam et.','Bitirmek, mükemmel olmaktan iyidir.'];
if(S.qd!==todayStr){S.qd=todayStr;S.qi=Math.floor(Date.now()/864e5)%QS.length}
function qUI(){const a=QS.concat(S.quotes);S.qi=((S.qi%a.length)+a.length)%a.length;$('qText').textContent='“'+a[S.qi]+'”'}
$('qNext').onclick=()=>{S.qi++;qUI();sv()};
$('qAdd').onclick=()=>{const v=$('qIn').value.trim();if(!v)return;S.quotes.push(v);S.qi=QS.length+S.quotes.length-1;$('qIn').value='';qUI();sv()};
if(S.water.day!==todayStr)S.water={day:todayStr,n:0};
function wUI(){$('wTxt').textContent=`${S.water.n} / 8 bardak`;
  $('drops').innerHTML=Array.from({length:8},(_,i)=>`<button class="drop" data-i="${i}" aria-label="Bardak ${i+1}"><svg viewBox="0 0 24 28"><path d="M12 2C12 2 4 12 4 18a8 8 0 0016 0c0-6-8-16-8-16z" style="fill:${i<S.water.n?'var(--teal)':'color-mix(in srgb,var(--teal) 22%,transparent)'};stroke:var(--teal)" stroke-width="1.5"/></svg></button>`).join('')}
$('drops').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const i=+b.dataset.i;S.water.n=(i+1===S.water.n)?i:i+1;if(S.water.n>i)sfx();sv();wUI()});

// ---- Takvim ----
tasks.forEach(t=>{if(!t.date){const ms=parseInt(String(t.id).slice(0,8),36);t.date=(ms>1.5e12&&ms<=Date.now()+864e5)?new Date(ms).toLocaleDateString('sv-SE'):todayStr}});
save();selDate=todayStr;let calM=new Date();calM.setDate(1);
function calUI(){
  const y=calM.getFullYear(),m=calM.getMonth(),first=(new Date(y,m,1).getDay()+6)%7,days=new Date(y,m+1,0).getDate(),by={};
  tasks.forEach(t=>{(by[t.date]=by[t.date]||[]).push(t)});
  $('calTitle').textContent=calM.toLocaleDateString('tr-TR',{month:'long',year:'numeric'});
  let h='';for(let i=0;i<first;i++)h+='<i></i>';
  for(let d=1;d<=days;d++){const k=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`,a=by[k]||[],dn=a.filter(t=>t.done).length;
    h+=`<button class="dy ${k===selDate?'sel':''} ${k===todayStr?'tod':''}" data-d="${k}" aria-label="${d}. gün, ${a.length} görev"><span>${d}</span>${a.length?`<em class="${dn===a.length?'ok':'pend'}">${dn}/${a.length}</em>`:''}</button>`}
  $('calGrid').innerHTML=h;
}
function dayUI(){
  const d=new Date(selDate+'T12:00:00'),isT=selDate===todayStr;
  $('dayTitle').textContent=(isT?'Bugün · ':'')+d.toLocaleDateString('tr-TR',{day:'numeric',month:'long',weekday:'long'})+(selDate<todayStr?' (geçmiş gün)':selDate>todayStr?' (planlanan)':'');
  const late=tasks.filter(t=>t.date<todayStr&&!t.done&&!t.moved).length,show=isT&&late>0;
  $('carry').classList.toggle('hidden',!show);$('carry').classList.toggle('flex',show);$('carryTxt').textContent=`Önceki günlerden tamamlanmamış ${late} görev var.`;
}
$('calGrid').addEventListener('click',e=>{const b=e.target.closest('[data-d]');if(!b)return;selDate=b.dataset.d;render()});
$('calPrev').onclick=()=>{calM.setMonth(calM.getMonth()-1);calUI()};
$('calNext').onclick=()=>{calM.setMonth(calM.getMonth()+1);calUI()};
$('calToday').onclick=()=>{selDate=todayStr;calM=new Date();calM.setDate(1);render()};
$('carryBtn').onclick=()=>{tasks.filter(t=>t.date<todayStr&&!t.done&&!t.moved).forEach(t=>{t.moved=true;tasks.unshift({id:uid(),title:t.title,cat:t.cat,pri:t.pri,energy:t.energy||'high',done:false,date:todayStr})});save();render()};

applyTheme();syncChips();fxStart();qUI();wUI();
pUI();
render();
</script>
